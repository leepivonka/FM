006038  1  A2 40 00     	ldx #PSP_Init
00603B  1  60           	rts
00603C  1               
00603C  1               
00603C  1                .if 0
00603C  1                Header "0",0 ; ( -- 0 )  push 0
00603C  1                 ; Used frequently, so define this instead of using literals.
00603C  1               Zero:

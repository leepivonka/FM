006000  1               Cold: ; Cold start
006000  1               
006000  1  18           	CLC
006001  1  FB           	XCE		; CPU to native mode
006002  1  C2 38        	rep #P_M|P_X|P_D ; 16-bit registers, not decimal
006004  1               
006004  1  A9 00 04     	lda #UserFirst	; Initialize User Pointer
006007  1  5B           	tcd
006008  1               
006008  1  A9 AF 04     	LDA #RSP_Init+UserFirst
00600B  1  1B           	TAS		; reset return stack
00600C  1  A2 40 00     	LDX #PSP_Init	; reset parameter stack
00600F  1               
00600F  1  4B           	phk		; Set Data Bank to Code bank ($00)
006010  1  AB           	plb
006011  1               
006011  1  20 E7 6C     	jsr Decimal
006014  1               
006014  1  64 02        	stz U_State	; STATE = 0
006016  1               

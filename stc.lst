00001A  1               ; These are in the user area so they are simpler to use.
00001A  1               ; It's OK to have these as per-user even though they don't need to be.
00001A  1               
00001A  1               ;-- Scratch variables, default is not preserved across subroutine calls
00001A  1  xx xx        W:		.res 2
00001C  1  xx xx        Temp0:		.res 2
00001E  1  xx xx        Temp2:		.res 2
000020  1  xx xx        Temp4:		.res 2
000022  1  xx xx        Temp6:		.res 2
000024  1               
000024  1  xx xx xx xx  U_User:		.res 12		; user-defined user variable space
000028  1  xx xx xx xx  
00002C  1  xx xx xx xx  

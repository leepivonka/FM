00602E  1               
00602E  1  42 79 65 03   Header "Bye",0 ; ( -- ) halt the system
006032  1  2C 60        
006034  1                 ; https://forth-standard.org/standard/tools/BYE
006034  1  4C 84 E0     Bye:	jmp $00e084	; Mensch Reset
006037  1               
006037  1               
006037  1  41 62 6F 72   Header "Abort",0 ; ( -- ) reset stacks and go to QUIT
00603B  1  74 05 34 60  
00603F  1                 ; https://forth-standard.org/standard/core/ABORT
00603F  1               Abort:
00603F  1  20 2E 78     	jsr PSP_Reset	; reset parm stack
006042  1               
006042  1  20 22 6F     	jsr DotQuoteRun
006045  1  05 00        	.word 5
006047  1  3F 00 20     	.byte "?",0," " ; this phrase makes the simulator stop copying from an input file
00604A  1  0D 0A        	.byte $0d,$0a
00604C  1  80 07        	bra Quit
00604E  1               
00604E  1               
00604E  1  51 75 69 74   Header "Quit",0 ; ( -- ) outer interpreter loop
006052  1  04 3F 60     
006055  1                 ; Resets return stack, reads and interprets input forever
006055  1                 ; https://forth-standard.org/standard/core/QUIT
006055  1               Quit:
006055  1  A9 C1 04     	lda #RSP_Init+UserFirst	; Reset return stack
006058  1  1B           	tcs
006059  1  64 0E        	stz U_Blk
00605B  1  64 0C        	stz U_SourceId
00605D  1  64 02        	stz U_State		; STATE= interpret
00605F  1  64 16        	stz U_IfState
006061  1               
006061  1  20 86 60     @Loop:	jsr Refill
006064  1  E8           	inx			; drop Refill result
006065  1  E8           	inx
006066  1  20 87 70     	jsr Space		; type a space after the line
006069  1  20 0D 61     	jsr Interpret		; Interpret the input line
00606C  1  A5 02        	lda U_State		; STATE == 0 (interpret mode)?
00606E  1  D0 08        	bne @8			; Loop back (compiling: no prompt)
006070  1  20 22 6F     	jsr DotQuoteRun
006073  1  03 00        	.word 3			; Print " ok"
006075  1  20 6F 6B     	.byte " ok"
006078  1  20 77 70     @8:	jsr CR
00607B  1  80 E4        	bra @Loop

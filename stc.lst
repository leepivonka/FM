00602C  1               ; SECTION 1: PARAMETER STACK
00602C  1               
00602C  1  50 53 50 2D   Header "PSP-Reset",0 ; ( ... -- )  clear parameter stack
006030  1  52 65 73 65  
006034  1  74 09 2A 60  

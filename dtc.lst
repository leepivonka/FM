006F71  1  85 6A        @loop:	sta Temp0	;   done?
006F73  1  E4 6A        	cpx Temp0
006F75  1  B0 14        	bcs @done
006F77  1  3A           	dea
006F78  1  3A           	dea
006F79  1  48           	pha
006F7A  1  DA           	phx		;   get value
006F7B  1  AA           	tax
006F7C  1  B5 26        	lda PStack,x
006F7E  1  FA           	plx
006F7F  1  20 50 66     	jsr print_udec	;   print value
006F82  1  A9 20 00     	lda #' '	;   print space
006F85  1  20 48 65     	jsr EmitA
006F88  1  68           	pla
006F89  1  80 E6        	bra @loop

000000r 1               ;==============================================================================
000000r 1               ; 65816 ANS Forth Kernel (DTC)
000000r 1               ; Set up to run on WDC w65c265sxb board.
000000r 1               ; Based on http://forum.6502.org/viewtopic.php?f=9&t=8577
000000r 1               ;	https://github.com/Martin-H1/65816/tree/main/Forth816
000000r 1               ;
000000r 1               ; Architecture:
000000r 1               ;	Threading:	Direct Threaded Code (DTC)
000000r 1               ;	Cell size:	16-bit
000000r 1               ;
000000r 1               ; DTC execution model:
000000r 1               ;	Each word starts with machine code.
000000r 1               ;	DoCol will start interpreting colon code.
000000r 1               
000000r 1               ; Default word entry environment:
000000r 1               ;	Native mode, P.M=16-bit, P.X=16-bit
000000r 1               ;	A  (16-bit) scratch
000000r 1               ;	X  (16-bit) Parameter Stack Pointer (PSP) - index to TOS in PStack
000000r 1               ;	Y  (16-bit) scratch
000000r 1               ;	S  (16-bit) Return Stack Pointer (RSP)	  - hardware stack
000000r 1               ;	D		Direct Page base (UP)	  points to user area
000000r 1               ;	DB		Data Bank ($00)
000000r 1               ;
000000r 1               ; User area is the direct page.
000000r 1               ; Parameter stack TOS is at PStack,x
000000r 1               ; Return stack TOS is at 1,s
000000r 1               ; Temp* variables are available without preserving.
000000r 1               
000000r 1               Blocks = 1	; enable block code
000000r 1               Opt_Full = 1	; enable everything
000000r 1               
000000r 1               	.p816			;select 65816 CPU
000000r 1               	.list on
000000r 1               	.listbytes unlimited ;include all object bytes in listing (since we load the listing file)
000000r 1               	.feature loose_string_term ; used to put quotes in strings
000000r 1               	.feature org_per_seg
000000r 1               	.smart		;watch the code to determine P_M & P_X sizes
000000r 1               
000000r 1               ; Memory segment layout.
000000r 1               ; These are absolute instead of relative:
000000r 1               ;   * absolute addresses are in listing
000000r 1               ;   * allow loading by report-scraping the listing (no link step).
000000r 1               ; This could be changed to be more conventional.
000000r 1                 .bss	; uninitialized read-write
000000r 1               	.org $300	; in 65c265sxb onboard RAM, away from Mensch monitor stuff in lo RAM
000300  1               BssEnd=$6000
000300  1                 .code ; initialized, read-only
000000r 1               	.org $6000	; in 65c265sxb onboard RAM for now
006000  1               
006000  1               
006000  1               ; CPU P flag bits:
006000  1               P_I	= $04	; interrupt disable
006000  1               P_D	= $08	; decimal
006000  1               P_X	= $10	; X size
006000  1               P_M	= $20	; M size
006000  1               
006000  1               ;==============================================================================
006000  1               ; ca65 Macros
006000  1               
006000  1                 .macro NEXT ; Inner interpreter dispatch
006000  1               	jmp Next1
006000  1               	.endmacro
006000  1               
006000  1               
006000  1                 .macro PUSHA ; Push value in A onto parameter stack
006000  1               	DEX
006000  1               	DEX
006000  1               	STA PStack,x
006000  1               	.endmacro
006000  1               
006000  1               
006000  1                 .macro POPA ; Pop top of parameter stack into A
006000  1               	INX
006000  1               	INX
006000  1               	LDA PStack-2,x	; set A & flags
006000  1               	.endmacro
006000  1               
006000  1               
006000  1               ; Word header flag & length byte bits:
006000  1               F_Immediate	= $80	; when compiling, execute this word
006000  1               F_Hidden	= $40	; smudged
006000  1               F_Inline	= $20	; code can be compiled inline
006000  1               F_LengthMask	= $1F	; mask for name length bits
006000  1               
006000  1                .macro Header name, flags ; generate a dictionary entry header
006000  1               ;	name	- string literal for the name field
006000  1               ;	flags	- F_Immediate, F_Hidden, or 0
006000  1               
006000  1               	.local L1,L2
006000  1               ;	WordHeader_Extend	; user-supplied extension
006000  1               L1:	.byte name	;name of word as a string
006000  1               L2:	.byte L2-L1+flags ;flags & length of name (see F_*)
006000  1               	.addr DictLink ;link to previous word in dictionary chain
006000  1               ;		The fields above are at negative offsets from label.
006000  1               DictLink .set * ; remember the entry point of this word for later
006000  1               ;		xt & nt of this word are here.
006000  1               ;label:	; machine code is here.  This is the address that "Search-WordList" returns.
006000  1               ;	CFA jsr (if needed) is here.
006000  1               	.endmacro
006000  1               
006000  1               DictLink .set 0 ;ptr to nt & xt of previous word, 0=end of list
006000  1               		; Used by Header to chain the generated word headers together.
006000  1               
006000  1               ;=============================================================================
006000  1                .zeropage ; Current direct page, aka User Area
000000r 1               ; ca65 will use direct page addressing for these automatically.
000000r 1               ; This is only a definition - it does not allocate any memory by itself - see UserFirst.
000000r 1               
000000r 1               ; On the 65816 with it's moveable direct page, we'll just make the direct page the user area.
000000r 1               ; We don't put it at $000000 so we don't conflict with the '265 Mensch monitor stuff.
000000r 1               ; The current copy of these variables should be accessed using direct addressing.
000000r 1               ; Absolute addressing doesn't take the D register into account.
000000r 1               	.org 0 ; create offsets in user area segment
000000  1               
000000  1  xx xx        U_Base:		.res 2		; Numeric I/O base
000002  1  xx xx        U_State:	.res 2		; Compile state, 0=interp, else compile
000004  1  xx xx        U_DP:		.res 2		; Dictionary memory pointer
000006  1  xx xx        U_Latest:	.res 2		; ptr Latest word header
000008  1  xx xx        U_LatestXt:	.res 2		; ptr Latest word xt (see :NoName )
00000A  1  xx xx        U_Scr:		.res 2		;
00000C  1  xx xx        U_SourceId:	.res 2		; Source Id
00000E  1  xx xx        U_Blk:		.res 2		; 0 or # number of the block being interpreted.
000010  1               				;   https://forth-standard.org/standard/block/BLK
000010  1  xx xx        U_ParseBuf:	.res 2		; Source string buffer address
000012  1  xx xx        U_ParseLen:	.res 2		; Source string length
000014  1  xx xx        U_ToIn:		.res 2		; >IN  parse offset in U_ParseBuf
000016  1  xx xx        U_HoldIndex:	.res 2		; current start of HOLD string
000018  1  xx xx        U_FSP:		.res 2		; Floating-Point stack index
00001A  1  xx xx        U_FSFull:	.res 2		; FSP full value
00001C  1  xx xx        U_FSEmptyP1:	.res 2		; FSP empty +1 value
00001E  1  xx xx xx xx  U_RandState:	.res 4		; random # state
000022  1               ;U_ExceptionHandler: .res 2	; Exception handler
000022  1  xx xx        U_IP:		.res 2		; Colon instruction Pointer

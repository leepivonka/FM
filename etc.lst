00602B  1  42 79 65 03   Header "Bye",0 ; ( -- ) halt the system
00602F  1  29 60        
006031  1                 ; https://forth-standard.org/standard/tools/BYE
006031  1  4C 84 E0     Bye:	jmp $00e084	; Mensch Reset
006034  1               
006034  1               
006034  1  41 62 6F 72   Header "Abort",0 ; ( -- ) reset stacks and go to QUIT
006038  1  74 05 31 60  
00603C  1                 ; https://forth-standard.org/standard/core/ABORT
00603C  1               Abort:
00603C  1  20 24 76     	jsr PSP_Reset	; reset parm stack
00603F  1  A9 4A 60     	lda #@Text	; type msg
006042  1  A0 05 00     	ldy #5
006045  1  20 A0 6E     	jsr TypeYA
006048  1  80 0C        	bra Quit
00604A  1               
00604A  1  3F 00 20     @Text:	.byte "?",0," " ; this phrase makes the simulator stop copying from an input file
00604D  1  0D 0A        	.byte $0d,$0a
00604F  1               
00604F  1               
00604F  1  51 75 69 74   Header "Quit",0 ; ( -- ) outer interpreter loop
006053  1  04 3C 60     
006056  1                 ; Resets return stack, reads and interprets input forever
006056  1                 ; https://forth-standard.org/standard/core/QUIT
006056  1               Quit:
006056  1  A9 BF 04     	lda #RSP_Init+UserFirst	; Reset return stack
006059  1  1B           	tcs
00605A  1  64 02        	stz U_State		; STATE= interpret
00605C  1               
00605C  1  20 85 60     @Loop:	jsr Refill
00605F  1  E8           	inx			; drop Refill result
006060  1  E8           	inx
006061  1  20 6F 6E     	jsr Space		; type a space after the line
006064  1  20 0C 61     	jsr Interpret		; Interpret the input line
006067  1  A5 02        	lda U_State		; STATE == 0 (interpret mode)?
006069  1  D0 09        	bne @8			; Loop back (compiling: no prompt)
00606B  1  A9 79 60     	lda #@Ok			; Print " ok"
00606E  1  A0 03 00     	ldy #3
006071  1  20 A0 6E     	jsr TypeYA
006074  1  20 5C 6E     @8:	jsr CR
006077  1  80 E3        	bra @Loop
